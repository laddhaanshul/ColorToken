{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": [
      "ES2018",
      "DOM"
    ],
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/esm",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/tokens/**/*",
    "src/utils/**/*",
    "src/config.ts",
    "src/providers/ColorProvider.tsx",
    "src/providers/index.ts",
    "src/providers/types.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}